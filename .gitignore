# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js
.next/
out/

# production
build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template carries no values, and the README tells you to copy it.
!.env.example
!**/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.gstack/
.scratch/

# vitest blob reports (CI merges them for coverage)
.vitest-reports

# Foundry build artifacts (contracts/) — lib/ (vendored deps) is committed.
/contracts/out/
/contracts/cache/
/contracts/broadcast/

# playwright
test-results/
playwright-report/
blob-report/
.pnpm-store/

# Personal local scratch notes — not part of the repo.
COMMANDS.md

# Session transcript. Contains pasted connection strings and keys.
chat-history.txt

# Project-scoped MCP config. Holds personal project refs and token env-var
# wiring, so it stays local; .mcp.json.example is the committed template.
.mcp.json

# Seed/dummy account credentials — NEVER commit (AGENTS.md: never echo credentials)
SEED-CREDENTIALS.md
SEED-CREDENTIALS*.md
SHOWCASE-CREDENTIALS.md
SHOWCASE-CREDENTIALS*.md
*.credentials.json
