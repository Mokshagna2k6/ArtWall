# ArtWall — environment template.
#
# Copy to `apps/web/.env` and fill in real values. Never commit the result:
# `.gitignore` excludes `.env*`, and CI fails on any committed secret
# (gitleaks, .github/workflows/ci.yml → secrets-scan).
#
# Every name below is read somewhere in apps/web/src, apps/web/scripts or
# packages/*. Placeholder values are illustrative shapes, not working values.

# ---------------------------------------------------------------------------
# Required — the app will not start or build without these
# ---------------------------------------------------------------------------

# Supabase Postgres, POOLED connection (Supabase dashboard -> Connect ->
# "Transaction", port 6543). `pnpm build` needs this reachable: sitemap.ts
# queries the database at build time.
#
# IMPORTANT (AGENTS.md): confirm the hostname matches the project your
# deployment actually uses before running a migration locally. This has drifted
# before — a stale branch sat here while production had moved — and caused real
# confusion about what was deployed.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"

# DIRECT connection (port 5432). Required for migrations: the transaction
# pooler cannot run DDL or hold advisory locks.
DATABASE_URL_UNPOOLED="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Supabase Auth (migration 0074). Dashboard -> Project Settings -> API.
# ---------------------------------------------------------------------------

# Project URL and the anon key. Both are PUBLIC by design: the anon key
# identifies the project and Row Level Security decides what it may read.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Service-role key — a FULL-DATABASE credential that bypasses RLS. Server-side
# only (src/lib/supabase/server.ts `createAdminClient`). Never expose it to the
# browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Root server-side HMAC secret. Several unrelated features derive a
# purpose-separated key from it: physical-wall QR tokens, UGC upload folder
# paths, and the wallet-link signature. NOT an auth secret — Supabase Auth
# owns sessions and needs none.
#
# Was BETTER_AUTH_SECRET, which is still read as a fallback. Changing this
# value invalidates already-issued QR tokens and existing UGC folder paths.
# Generate with: openssl rand -base64 32
SERVER_SECRET="generate-a-32-byte-random-string"

# ---------------------------------------------------------------------------
# Feature flags — both default OFF; pages 404 rather than half-render
# ---------------------------------------------------------------------------
PHYSICAL_WALL_ENABLED="false"
MARKETPLACE_CHECKOUT_ENABLED="false"

# ---------------------------------------------------------------------------
# Images — Cloudinary (signed direct-to-cloud uploads)
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="000000000000000"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
# Optional: enable Cloudinary moderation on upload.
CLOUDINARY_MODERATION=""

# ---------------------------------------------------------------------------
# Email — Resend
# (docs/archive/plans/WORK_PLAN.md says AWS SES; that was superseded. Resend
#  is what notifications.ts actually uses.)
# ---------------------------------------------------------------------------
RESEND_API_KEY="re_your_resend_api_key"
NOTIFY_FROM_EMAIL="ArtWall <noreply@your-domain.com>"

# ---------------------------------------------------------------------------
# Payments — Razorpay. Use TEST keys locally, never live keys.
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"

# India tax identifiers printed on invoices.
ARTWALL_GSTIN="00XXXXX0000X0XX"
ARTWALL_GST_STATE_CODE="08"

# ---------------------------------------------------------------------------
# Google OAuth — optional; email/password sign-in works without it
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Blockchain — Base Sepolia testnet only at present
# ---------------------------------------------------------------------------
NEXT_PUBLIC_DEFAULT_CHAIN_ID="84532"
NEXT_PUBLIC_NFT_CONTRACT_ADDRESS="0x0000000000000000000000000000000000000000"
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID="your-walletconnect-project-id"
BASE_SEPOLIA_RPC_URL="https://sepolia.base.org"
BASE_RPC_URL=""
POLYGON_AMOY_RPC_URL=""
POLYGON_RPC_URL=""
# Server-side signer for lazy-mint vouchers. Treat as highly sensitive.
MINT_SIGNER_PRIVATE_KEY=""
MINT_REQUIRED_CONFIRMATIONS="2"

# IPFS pinning — Pinata
PINATA_JWT=""
NEXT_PUBLIC_PINATA_GATEWAY=""

# ---------------------------------------------------------------------------
# NFC tags / QR provenance
# ---------------------------------------------------------------------------
# Ed25519 seed for signing QR payloads. Generate with: openssl rand -hex 32
QR_SIGNING_ED25519_SEED=""
# Reference to the NTAG424 master key in a KMS — not the key itself.
NTAG424_MASTER_KEY_KMS_REF=""

# ---------------------------------------------------------------------------
# Cache and rate limiting — Upstash Redis.
# Optional: @artwall/cache and @artwall/ratelimit fall back to in-memory and
# Postgres stores when unset. Single-instance only, so set these in production.
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---------------------------------------------------------------------------
# Cron — Vercel Cron sends this as a bearer token; routes reject without it
# ---------------------------------------------------------------------------
CRON_SECRET="generate-a-long-random-string"

# ---------------------------------------------------------------------------
# Logistics — Shiprocket (BE-3.16; not built yet)
# ---------------------------------------------------------------------------
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""

# ---------------------------------------------------------------------------
# AI assistant — Anthropic
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY="sk-ant-your-api-key"

# ---------------------------------------------------------------------------
# Legacy password-gated /admin/tiles tool. Comma-separated allowlist for the
# role-based admin area is ADMIN_EMAILS.
# ---------------------------------------------------------------------------
ADMIN_PASSWORD=""
ADMIN_EMAILS=""

# ---------------------------------------------------------------------------
# Public base URL, used for absolute links in emails, PDFs and metadata
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Local tuning
# ---------------------------------------------------------------------------
# Max `pg` pool connections. Keep low on serverless.
PG_POOL_MAX=""

# ---------------------------------------------------------------------------
# Seeding and tests — NEVER point these at production.
# scripts/seed-guard.mjs refuses to run against the production hostname.
# See docs/SEED-DATA.md.
# ---------------------------------------------------------------------------
SEED_DATABASE_URL=""
SEED_ADMIN_EMAIL=""
SEED_ARTIST_EMAIL=""
SEED_STAFF_EMAIL=""
SEED_PASSWORD=""
# Integration suite (vitest.db.config.ts). CI uses a non-superuser owner so the
# append-only TRUNCATE-refusal assertions are meaningful.
TEST_DATABASE_URL=""
DB_TEST_ROLE=""
