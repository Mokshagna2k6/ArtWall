{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "_regions_note": "sin1 would put functions beside the Supabase project (ap-southeast-1). Vercel IGNORES this key on Hobby — X-Vercel-Id still reports bom1::iad1 after deploying it. Set it in the dashboard instead: Project Settings -> Functions -> Function Region -> Singapore. Needs Pro.",
  "regions": [
    "sin1"
  ],
  "crons": [
    {
      "path": "/api/cron/deliver-notifications",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/refunds",
      "schedule": "15 1 * * *"
    },
    {
      "path": "/api/cron/merkle-root",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/blockchain/cron/reconcile-mints",
      "schedule": "45 1 * * *"
    },
    {
      "path": "/api/cron/data-retention",
      "schedule": "30 21 * * *"
    },
    {
      "path": "/api/cron/uptime-check",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/demand-aggregate",
      "schedule": "15 2 * * *"
    }
  ]
}
