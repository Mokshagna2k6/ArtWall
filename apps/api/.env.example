# ArtWall Railway scheduler — environment template.
#
# Set these in the Railway service's Variables tab, not in a committed file.
# The service refuses to start without WEB_APP_URL and CRON_SECRET, rather than
# running and 401-ing on every job while looking healthy.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# The deployed Vercel app this scheduler calls. No trailing slash needed —
# run-job.js strips one if present. Must be the PUBLIC url: the scheduler
# reaches it over the internet, not through a private network.
WEB_APP_URL="https://your-app.vercel.app"

# Must be byte-identical to the CRON_SECRET set on the Vercel app. It is sent
# as `Authorization: Bearer <secret>` and checked by `isCronAuthorized` in
# apps/web/src/lib/cron.ts, which fails closed. A mismatch means every job
# returns 401 — and that is deliberately NOT retried, so it surfaces in the
# logs on the first tick instead of after three.
CRON_SECRET="same-value-as-the-vercel-app"

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Timezone for the cron expressions in src/jobs.js. The schedules were written
# for IST, which is what the business runs on, so this defaults to
# Asia/Kolkata. Vercel Cron was UTC-only — changing this shifts when every job
# fires, so change it deliberately.
CRON_TZ="Asia/Kolkata"

# Railway injects PORT itself. Only set this for local runs.
# PORT="8080"
