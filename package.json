{
  "name": "artwall",
  "version": "0.1.0",
  "private": true,
  "description": "ArtWall — India's digital home for artists. Pre-launch experience site.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs",
    "db:check": "node --env-file=.env scripts/db-check.mts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:e2e": "playwright test",
    "db:seed-accounts": "node --env-file=.env scripts/seed-accounts.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@neondatabase/serverless": "^1.1.0",
    "@noble/hashes": "2.3.0",
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@swc/helpers": "0.5.15",
    "@tanstack/react-query": "^5.104.0",
    "@types/qrcode": "^1.5.6",
    "better-auth": "^1.6.26",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^13.0.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.29.0",
    "next": "16.3.8",
    "pg": "^8.23.0",
    "pinata": "^2.5.6",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0",
    "viem": "^2.56.9",
    "wagmi": "^2.19.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  }
}
