{
  "name": "artwall-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "ArtWall pnpm workspace. The Next.js app lives in apps/web; see docs/plans/PRODUCTION_SCALE_PLAN.md.",
  "scripts": {
    "dev": "pnpm --filter @artwall/web dev",
    "build": "pnpm --filter @artwall/web build",
    "start": "pnpm --filter @artwall/web start",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:db": "pnpm --filter @artwall/web test:db",
    "test:e2e": "pnpm --filter @artwall/web test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @artwall/web db:migrate",
    "db:check": "pnpm --filter @artwall/web db:check",
    "db:seed-accounts": "pnpm --filter @artwall/web db:seed-accounts"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  }
}
